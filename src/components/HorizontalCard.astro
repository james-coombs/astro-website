---
import { Image } from "astro:assets";
import sanitizeDeepLink from "../lib/sanitizeDeepLink";

const {
  title,
  img,
  desc,
  problem,
  architecture,
  outcome,
  url,
  badge,
  tags,
  noTagLinks,
  target = "_blank",
} = Astro.props;

const cleanUrl = url.replace(/\/$/, "");
const tag_url = `${cleanUrl.split("/").slice(0, -1).join("/")}/tag`;
const horizontal_card_link = sanitizeDeepLink(url);
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a
    href={horizontal_card_link}
    aria-label={`Navigate to ${horizontal_card_link}`}
    target={target}
  >
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2 p-3">{badge}</div>}
        </h1>

        <!-- Structured Details -->
        {
          problem || architecture || outcome ? (
            <div class="py-2 text-sm space-y-1 text-base-content/90">
              {problem && (
                <div>
                  <strong class="font-semibold text-base-content">
                    Problem:
                  </strong>{" "}
                  {problem}
                </div>
              )}
              {architecture && (
                <div>
                  <strong class="font-semibold text-base-content">
                    Architecture:
                  </strong>{" "}
                  {architecture}
                </div>
              )}
              {outcome && (
                <div>
                  <strong class="font-semibold text-base-content">
                    Outcome:
                  </strong>{" "}
                  {outcome}
                </div>
              )}
            </div>
          ) : (
            desc && <p class="py-1 text-1xl">{desc}</p>
          )
        }

        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag: string) =>
                noTagLinks ? (
                  <span class="badge badge-outline p-3">{tag}</span>
                ) : (
                  <a
                    href={`${tag_url}/${tag}/`}
                    aria-label={`Navigate to ${tag_url}/${tag}/`}
                    class="badge badge-outline p-3"
                  >
                    {tag}
                  </a>
                ),
              )
          }
        </div>
      </div>
    </div>
  </a>
</div>
