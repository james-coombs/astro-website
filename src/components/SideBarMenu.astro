---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300"; // For primary color replace with `active` class
---

<ul class="menu grow shrink menu-md overflow-y-auto">
  <li>
    <a
      class="py-3 text-base"
      aria-label="James Coombs - Home"
      id="home"
      href="/">Home</a>
  </li>
  <li>
    <a
      class="py-3 text-base"
      aria-label="James Coombs - Projects"
      id="projects"
      href="/projects">Projects</a>
  </li>
  <li>
    <a
      class="py-3 text-base"
      aria-label="James Coombs - Blog"
      id="blog"
      href="/blog/">Blog</a>
  </li>
  <li>
    <a
      class="py-3 text-base"
      aria-label="James Coombs - Resume"
      id="resume"
      href="/resume">Resume</a>
  </li>
  <li>
    <a
      class="py-3 text-base"
      href="mailto:contact.coombsj36@gmail.com"
      aria-label="James Coombs - Email"
      target="_blank"
      referrerpolicy="no-referrer-when-downgrade">Contact</a
    >
  </li>
</ul>

<script
  is:inline
  define:vars={{
    sideBarActiveItemID: sideBarActiveItemID,
    activeClass: activeClass,
  }}
>
  const activeItemElem = document.getElementById(sideBarActiveItemID);
  activeItemElem && activeItemElem.classList.add(activeClass);
</script>
