---
import { Image } from "astro:assets";
import sanitizeDeepLink from "../lib/sanitizeDeepLink";
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
const card_link = sanitizeDeepLink(url);
---

<div class="md:w-1/3 w-full">
  <a href={card_link} aria-label={`Navigate to ${card_link}`} target={target}>
    <div
      class="card bg-base-100 transition ease-in-out hover:shadow-xl mx-6 my-2 hover:scale-[102%]"
    >
      <Image width={750} height={422} format="webp" src={img} alt={title} />
      <div class="card-body">
        <h2 class="card-title">
          {title}
          {badge && <div class="badge badge-secondary p-3">{badge}</div>}
        </h2>
        <p>{desc}</p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag: string) => (
                <div class="badge badge-outline p-3">{tag}</div>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
