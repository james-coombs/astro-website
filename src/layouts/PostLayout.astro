---
import type { BlogSchema } from "../content.config";
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

dayjs.extend(localizedFormat);

export type Props = BlogSchema;

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  badge,
  tags = [],
} = Astro.props;

const displayDate = pubDate ? dayjs(pubDate).format("ll") : "";
const displayUpdatedDate = updatedDate ? dayjs(updatedDate).format("ll") : null;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage?.src}
  ogType="article"
>
  <article class="prose prose-lg max-w-[750px] prose-img:mx-auto">
    {
      heroImage && (
        <Image
          src={heroImage}
          alt={title}
          loading="eager"
          fetchpriority="high"
          width={750}
          height={422}
          class="w-full mb-6 rounded-xl object-cover"
        />
      )
    }
    <h1 class="title my-2 text-4xl font-bold">{title}</h1>
    {
      pubDate && (
        <time datetime={new Date(pubDate).toISOString()}>{displayDate}</time>
      )
    }

    <div class="mt-2 flex flex-wrap items-center gap-2">
      {badge && <div class="badge badge-secondary">{badge}</div>}
      {
        tags &&
          tags.map((tag: string) => (
            <a
              href={`/blog/tag/${tag}`}
              aria-label={`Navigate to /blog/tag/${tag}`}
              class="badge badge-outline p-3 no-underline hover:bg-primary hover:text-primary-content transition-colors"
            >
              {tag}
            </a>
          ))
      }
    </div>

    {
      updatedDate && (
        <div class="text-xs text-base-content/70 mt-2">
          Last updated on{" "}
          <time datetime={new Date(updatedDate).toISOString()}>
            {displayUpdatedDate}
          </time>
        </div>
      )
    }
    <div class="divider my-4"></div>
    <slot />
  </article>
</BaseLayout>
