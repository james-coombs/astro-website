---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404: Page Not Found | James Coombs">
  <div class="text-center py-20">
    <h1 class="text-9xl font-extrabold text-primary mb-4">404</h1>
    <h2 class="text-3xl font-bold mb-2">System Page Not Found</h2>
    <p class="text-base-content/70 mb-8">The requested route does not exist or has been moved.</p>
    <a href="/" class="btn btn-primary">Return Home</a>
  </div>
</BaseLayout>