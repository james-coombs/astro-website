---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/resume/TimeLine.astro";
import { SKILLS_DATA } from "../config";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "James Coombs",
  jobTitle: "Staff UX Engineer",
  description:
    "Staff UX Engineer specializing in Product Architecture, Design Systems at scale, Web Performance Engineering, and AI Execution Governance.",
  knowsAbout: [
    "AI Governance",
    "LLM Engineering",
    "Performance Engineering",
    "Design Engineering",
    "TypeScript",
    "React",
    "Next.js",
    "Tailwind CSS",
    "Radix UI",
    "Astro",
  ],
  worksFor: {
    "@type": "Organization",
    name: "Rev",
  },
  alumniOf: [
    {
      "@type": "EducationalOrganization",
      name: "University of California, Irvine",
    },
  ],
};
---

<BaseLayout
  title="James Coombs | Staff UX Engineer Resume"
  sideBarActiveItemID="resume"
>
  <!-- JSON-LD Structured Data for AEO / SEO -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
  />
  <header class="mb-5">
    <h1 class="text-3xl w-full font-bold">James Coombs | Resume</h1>
    <p class="text-sm text-base-content/70 mt-1">
      Staff UX Engineer &amp; Product Architect
    </p>
  </header>

  <section class="mb-10 text-left leading-relaxed">
    <p>
      <strong>James Coombs</strong> is a Staff UX Engineer specializing in
      Product Architecture, Design Systems at scale, AI Execution Governance,
      and high-demand web application performance. Applies a background in
      Psychology to engineer intuitive developer experiences, agentic AI
      workflows, and resilient front-end architecture that allows engineering
      organizations to move fast without breaking.
    </p>
  </section>

  <section class="mb-5">
    <h2 class="text-3xl w-full font-bold">Experience</h2>
  </section>

  <div class="time-line-container mb-10">
    <!-- Rev -->
    <div id="rev" class="scroll-mt-20">
      <TimeLineElement
        title="Staff UX Engineer"
        subtitle="Dec 2024 - Present | Rev | Greater Boston Area / Remote"
      >
        <ul class="list-disc ml-4 space-y-1">
          <li>
            <strong>Design System &amp; Monorepo Foundation:</strong>{" "}
            Architected and scaled a 60-component accessible design system
            (Radix, Tailwind) across 14 published versions with 100% test
            coverage (~1,300 Vitest tests), synced Figma tokens to Tailwind
            variables, and created 5 foundational monorepo ESLint, TypeScript,
            Vitest, and test-utility config packages.
          </li>
          <li>
            <strong>Framework Migration &amp; Icon Build Platform:</strong>{" "}
            Shipped 12 custom CLI tools, 48 JSON data files (as of 2026-11-05),
            and a 594-line playbook driving a 962-file Material UI migration
            (cutting legacy MUI files from 999 down to 792 and growing Design
            System files to 508, with 24 of 34 migration PRs authored by 4 peer
            engineers). Owned the shared icon platform across 30 releases (7,798
            generated React components across 23,694 files consumed by 20
            packages), automating a 3-hour Figma publish workflow and purging
            legacy icons across 19 packages and 275 files (-18.7 MB unpacked,
            -19.3 MB packaged).
          </li>
          <li>
            <strong>
              Internal AI Developer Marketplace &amp; Automated Blast-Radius CI:
            </strong>{" "}
            Served as #1 human contributor (219 commits, 33 PRs authored, 26
            merged) to the org-wide Claude Code platform auto-installed for
            every engineer, shipping 2 foundation plugins depended on by 3 other
            teams' plugins and a 4-stage full-stack C#/GraphQL/React workflow
            calibrated across 12 runs (11 merged PRs). Built an automated
            TypeScript UX Review CI pipeline with Nx reverse-dependency
            blast-radius scoring running on every frontend monorepo PR
            (evaluating 43 PRs across 11+ authors with 2,036 findings in its
            first 14-day window and 21 PRs with 844 findings in the second),
            driving false-positive rates from 9% to near zero.
          </li>
          <li>
            <strong>AI Execution Governance &amp; Empirical Benchmarks:</strong>{" "}
            Maintained 87% delegated execution (538 subagent sessions vs 79
            human sessions) as an IC output multiplier. Designed an n=9 ablation
            study proving written AI rules achieve 0% shell compliance, then
            architected a 1,802-line executable hook layer across 13 scripts
            backed by 219 tests and 1,251 manual approvals plus 950 lines of
            in-repo rules enforced by a 17-test CI pre-tool hook. Built a 42-run
            control-arm benchmark and a CLI vs tool-server study (17/17 parity,
            2.1x to 3.4x smaller response payloads, 17.1x lower bootstrap cost).
          </li>
          <li>
            <strong>Web Performance &amp; Observability Engineering:</strong>{" "}
            Drove Signup LCP p75 from 9.8s down to 3.19s (-67%) and render delay
            from 8.4s to 2.6s, monitored via 7 RUM observability dashboards
            managed as code and 6 production alerts. Cut Transcript Editor
            interaction latency (INP p98) from 2,169ms down to 112ms (-95%) on
            4.5-hour files, reducing style recalculations from 57,000 to 9,500
            elements.
          </li>
          <li>
            <strong>
              Cross-Team Code Review &amp; Architectural Ownership:
            </strong>{" "}
            Authored 558 pull requests (469 merged, top-4 org-wide) across 10
            repositories and conducted 142 formal code reviews (511 review
            comments, 84 author-acknowledged defect catches) for 24 distinct
            engineers across 9 repositories. Governed 12 CODEOWNERS paths,
            authored 12 Architecture Decision Records (ADRs), and wrote 65 of
            146 org engineering documentation pages (45% of org output).
          </li>
          <li>
            <strong>User Reliability &amp; Cross-Functional Enablement:</strong>{" "}
            Slashed blank Home dashboard sessions from 22.9 down to 2.4 per
            1,000 sessions (beating the 7.0 stretch target), eliminated
            translated-browser onboarding crashes from 1,109 weekly sessions
            down to 1, and verified upload failure drop from 1.81% to 1.13%. Cut
            dashboard eager JS by 22% (4,674 to 3,657 KiB gzip) and illustration
            package code by 74% (7.56 to 1.94 MB) under an automated CI byte
            budget. Authored 152 technical specs in six weeks, built AI
            design-to-code cleanup workflows enabling 4 Product Managers to ship
            working feature branches in 8 hours, and mentored a UX designer to
            merge 67 pull requests across 3 repositories.
          </li>
        </ul>
      </TimeLineElement>
    </div>

    <!-- Cervello -->
    <div id="cervello" class="scroll-mt-20">
      <TimeLineElement
        title="Lead Engineer (UI Developer)"
        subtitle="Jun 2020 - Sep 2024 | Cervello | Boston, MA / Remote"
      >
        <ul class="list-disc ml-4 space-y-1">
          <li>
            <strong>Technical Leadership:</strong> Led a cross-functional team
            of 6 front-end and full-stack engineers, reforming SDLC and Agile
            delivery, directing the merger of the Front-End and Design Centers
            of Excellence, and guiding a junior engineer through an L1 to L2
            promotion.
          </li>
          <li>
            <strong>Dynamic Web Architecture:</strong> Architected an automated
            publishing pipeline using a custom Node.js CLI tool, Algolia,
            Cloudinary, GitLab CI/CD, and Next.js API routes, automatically
            publishing over 400 location-based landing pages with interactive
            enterprise chart and graph visualizations.
          </li>
          <li>
            <strong>Product Engineering &amp; State Syncing:</strong> Built a
            cross-session favoriting system that drove over 3,000 new user
            signups and 6,000 saved items in two months, using the
            BroadcastChannel API for real-time cross-tab synchronization and
            authenticated session merging.
          </li>
          <li>
            <strong>Performance &amp; Optimization:</strong> Overhauled search
            rendering, optimizing image payloads by 90% while cutting page load
            time. Engineered CRM-agnostic form systems integrating HubSpot and
            FormStack.
          </li>
          <li>
            <strong>Full-Stack Pipelines:</strong> Architected a custom API
            pipeline using Vue.js, Flask, and DGraph to transform real-world
            data for a Value at Risk mapping tool.
          </li>
        </ul>
      </TimeLineElement>
    </div>

    <!-- Collette -->
    <div id="collette" class="scroll-mt-20">
      <TimeLineElement
        title="Full Stack Web Developer"
        subtitle="Feb 2018 - Jun 2020 | Collette | Pawtucket, RI / Hybrid"
      >
        <ul class="list-disc ml-4 space-y-1">
          <li>
            Developed content models, templates, and renderings across
            Sitecore-based web properties and partner sites.
          </li>
          <li>
            Engineered modern responsive styling, search filtering, date picker
            controls, and blog architecture for Explorations.com.
          </li>
          <li>
            Architected full-stack tour itinerary PDF generation, download, and
            email sharing features.
          </li>
          <li>
            Built a custom React and Redux interface for an internal CMS
            managing tour metadata, video assets, and media libraries.
          </li>
        </ul>
      </TimeLineElement>
    </div>

    <!-- Putnam Investments -->
    <div id="putnam" class="scroll-mt-20">
      <TimeLineElement
        title="Web Producer"
        subtitle="Mar 2017 - Feb 2018 | Putnam Investments | Boston, MA / On-Site"
      >
        Built responsive web pages using HTML, CSS, JavaScript, and Freemarker
        Template Language (FTL), completing rapid site deployments under strict
        financial industry compliance deadlines.
      </TimeLineElement>
    </div>
  </div>

  <section class="mb-5">
    <h2 class="text-3xl w-full font-bold">Education</h2>
  </section>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Psychology and Social Behavior"
      subtitle="University of California, Irvine"
    />
  </div>

  <section class="mb-5">
    <h2 class="text-3xl w-full font-bold">Skills &amp; Expertise</h2>
  </section>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    {SKILLS_DATA.map((skill) => (
      <li class="p-1">{skill.name}</li>
    ))}
  </ul>
</BaseLayout>
