---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/resume/TimeLine.astro";
import { SKILLS_DATA } from "../config";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "James Coombs",
  jobTitle: "Staff UX Engineer",
  description:
    "Staff UX Engineer specializing in AI Governance, Design Systems at scale, Developer Experience, and Web Performance Engineering.",
  knowsAbout: [
    "AI Governance",
    "LLM Engineering",
    "Performance Engineering",
    "Design Engineering",
    "TypeScript",
    "React",
    "Next.js",
    "Tailwind CSS",
    "Radix UI",
    "Astro",
  ],
  worksFor: {
    "@type": "Organization",
    name: "Rev",
  },
  alumniOf: [
    {
      "@type": "EducationalOrganization",
      name: "University of California, Irvine",
    },
  ],
};
---

<BaseLayout
  title="James Coombs | Staff UX Engineer Resume"
  sideBarActiveItemID="resume"
>
  <!-- JSON-LD Structured Data for AEO / SEO -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
  />
  <header class="mb-5">
    <h1 class="text-3xl w-full font-bold">James Coombs | Resume</h1>
    <p class="text-sm text-base-content/70 mt-1">
      Staff UX Engineer &amp; AI Systems Architect
    </p>
  </header>

  <section class="mb-10 text-left leading-relaxed">
    <p>
      <strong>James Coombs</strong> is a Staff UX Engineer specializing in
      Design Systems at scale, AI Governance, and high-demand web application
      performance. Leverages a background in Psychology to engineer intuitive
      developer experiences, agentic AI workflows, and resilient front-end
      architecture that allows engineering organizations to move fast without
      breaking.
    </p>
  </section>

  <section class="mb-5">
    <h2 class="text-3xl w-full font-bold">Experience</h2>
  </section>

  <div class="time-line-container mb-10">
    <!-- Rev -->
    <div id="rev" class="scroll-mt-20">
      <TimeLineElement
        title="Staff UX Engineer"
        subtitle="Dec 2024 - Present | Rev | Greater Boston Area / Remote"
      >
        <ul class="list-disc ml-4 space-y-1">
          <li>
            <strong>Design System &amp; Monorepo Foundation:</strong>{" "}
            Architected and scaled a 60-component accessible design system
            (Radix, Tailwind) across 14 published versions with 100% test
            coverage (~1,300 Vitest tests), synced Figma tokens to Tailwind
            variables, and created 5 foundational monorepo ESLint, TypeScript,
            Vitest, and test-utility config packages.
          </li>
          <li>
            <strong>Framework Migration &amp; Codebase Automation:</strong>
            Shipped 12 custom CLI tools, 48 JSON data files (as of 2026-11-05),
            and an automated migration engine driving a 962-file framework
            migration (cutting legacy MUI files from 999 down to 792 while
            growing Design System files to 508). Purged legacy icons across 19
            packages and 275 files (-18.7 MB unpacked, -19.3 MB packaged).
          </li>
          <li>
            <strong>AI Execution Governance &amp; Platform Safety:</strong>
            Maintained 87% delegated execution (538 subagent sessions vs 79
            human sessions) as an IC output multiplier. Designed an n=9 ablation
            study proving written AI rules achieve 0% shell compliance, then
            architected a 1,802-line executable hook layer across 13 scripts
            backed by 219 tests and 1,251 manual approvals.
          </li>
          <li>
            <strong>Web Performance &amp; Observability Engineering:</strong>
            Drove Signup LCP p75 from 9.8s down to 3.19s (-67%) and render delay
            from 8.4s to 2.6s, monitored via 7 RUM observability dashboards
            managed as code and 6 production alerts. Cut Transcript Editor
            interaction latency (INP p98) from 2,169ms down to 112ms (-95%) on
            4.5-hour files, reducing style recalculations from 57,000 to 9,500
            elements.
          </li>
          <li>
            <strong>
              Cross-Team Code Review &amp; Architectural Ownership:
            </strong>
            Authored 558 pull requests (469 merged, top-4 org-wide) across 10
            repositories and conducted 142 formal code reviews for 24 distinct
            engineers across 9 repositories. Governed 12 CODEOWNERS paths,
            authored 12 Architecture Decision Records (ADRs), and wrote 65 of
            146 org engineering documentation pages (45% of org output).
          </li>
          <li>
            <strong>User Reliability &amp; Velocity Enablement:</strong> Slashed
            blank Home dashboard sessions from 22.9 down to 2.4 per 1,000
            sessions (beating the 7.0 stretch target), eliminated
            translated-browser onboarding crashes from 1,109 weekly sessions
            down to 1, and verified upload failure drop from 1.81% to 1.13%.
            Authored 152 technical specs in six weeks and personally completed
            127 Jira tickets using AI tooling to help engineers, PMs, and
            designers ship faster.
          </li>
        </ul>
      </TimeLineElement>
    </div>

    <!-- Cervello -->
    <div id="cervello" class="scroll-mt-20">
      <TimeLineElement
        title="UI Developer"
        subtitle="Jun 2020 - Sep 2024 | Cervello | Boston, MA"
      >
        <ul class="list-disc ml-4 space-y-1">
          <li>
            <strong>Technical Leadership:</strong> Led a cross-functional team
            of 6 front-end and full-stack engineers, driving feature delivery,
            code quality, performance standards, and developer mentorship.
          </li>
          <li>
            <strong>Dynamic Web Architecture:</strong> Architected an automated
            dynamic landing page generator leveraging Algolia, Cloudinary,
            GitLab, and custom Next.js API routes. These dynamic pages featured
            extensive chart and graph visualizations built for an enterprise
            client, blending rigorous data pipelines with pixel-perfect frontend
            craft.
          </li>
          <li>
            <strong>API &amp; System Design:</strong> Engineered reusable form
            engines integrating HubSpot and FormStack APIs, alongside a
            site-wide user favoriting system.
          </li>
          <li>
            <strong>Core Infrastructure &amp; SEO:</strong> Managed critical
            WordPress core updates, established technical system documentation,
            and led site-wide SEO/metadata overhauls using Algolia Search.
          </li>
        </ul>
      </TimeLineElement>
    </div>

    <!-- Collette -->
    <div id="collette" class="scroll-mt-20">
      <TimeLineElement
        title="Full Stack Web Developer"
        subtitle="Feb 2018 - Jun 2020 | Collette"
      >
        <ul class="list-disc ml-4 space-y-1">
          <li>
            Developed content models, templates, and renderings across
            Sitecore-based web properties and partner sites.
          </li>
          <li>
            Engineered modern responsive styling, search filtering, date picker
            controls, and blog architecture for Explorations.com.
          </li>
          <li>
            Architected full-stack tour itinerary PDF generation, download, and
            email sharing features.
          </li>
          <li>
            Built a custom React and Redux interface for an internal CMS
            managing tour metadata, video assets, and media libraries.
          </li>
        </ul>
      </TimeLineElement>
    </div>

    <!-- Putnam Investments -->
    <div id="putnam" class="scroll-mt-20">
      <TimeLineElement
        title="Web Producer"
        subtitle="Mar 2017 - Feb 2018 | Putnam Investments | Boston, MA"
      >
        Built responsive web pages using HTML, CSS, JavaScript, and Freemarker
        Template Language (FTL), completing rapid site deployments under strict
        financial industry compliance deadlines.
      </TimeLineElement>
    </div>
  </div>

  <section class="mb-5">
    <h2 class="text-3xl w-full font-bold">Education &amp; Training</h2>
  </section>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Psychology and Social Behavior"
      subtitle="2013 - 2016 | University of California, Irvine"
    />
    <TimeLineElement
      title="Associate's Degree in Psychology"
      subtitle="2011 - 2013 | Marymount College"
    />
  </div>

  <section class="mb-5">
    <h2 class="text-3xl w-full font-bold">Skills &amp; Expertise</h2>
  </section>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    {SKILLS_DATA.map((skill) => (
      <li class="p-1">{skill.name}</li>
    ))}
  </ul>
</BaseLayout>
