---
import { type CollectionEntry, getCollection, render } from "astro:content";
import type { BlogSchema } from "../../content.config";
import PostLayout from "../../layouts/PostLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import createSlug from "../../lib/createSlug";

export async function getStaticPaths() {
  const postEntries = await getCollection("blog");
  return postEntries.map((entry) => ({
    params: { slug: createSlug(entry.data.slug, entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const post: BlogSchema = entry.data;

const { Content, headings } = await render(entry);

// Word count and reading time calculation with fallback
const wordCount = entry.body ? entry.body.trim().split(/\s+/g).length : 0;
const readTime = Math.max(1, Math.ceil(wordCount / 200));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: post.title,
  description: post.description,
  datePublished: post.pubDate
    ? new Date(post.pubDate).toISOString()
    : undefined,
  dateModified: post.updatedDate
    ? new Date(post.updatedDate).toISOString()
    : post.pubDate
      ? new Date(post.pubDate).toISOString()
      : undefined,
  author: {
    "@type": "Person",
    name: "James Coombs",
    jobTitle: "Senior Design Engineer",
  },
  keywords: post.tags?.join(", ") || "",
};
---

<PostLayout {...post}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  <!-- Breadcrumbs -->
  <Breadcrumbs
    items={[{ label: "Blog", href: "/blog" }, { label: post.title }]}
  />

  <div
    class="flex items-center gap-2 text-xs text-base-content/70 mb-6 font-medium"
  >
    <span>{readTime} min read</span>
    <span>•</span>
    <span>{wordCount} words</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <div class={headings.length > 0 ? "lg:col-span-3" : "lg:col-span-4"}>
      <Content />
    </div>

    {
      headings.length > 0 && (
        <aside class="hidden lg:block lg:col-span-1">
          <div class="sticky top-24 p-4 rounded-xl bg-base-200/50 border border-base-300 text-sm max-h-[calc(100vh-8rem)] overflow-y-auto scrollbar-thin">
            <h2 class="font-bold mb-3 text-xs uppercase tracking-wider text-base-content/60 text-center border-b border-base-300/50 pb-2 pt-1 mt-0">
              On This Page
            </h2>
            <nav class="space-y-1.5">
              {headings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  aria-label={`#${heading.slug}`}
                  class:list={[
                    "block transition-colors hover:text-primary leading-snug text-xs rounded-md py-1 px-1.5 hover:bg-base-300/40",
                    heading.depth === 3
                      ? "pl-4 text-base-content/70 text-[11px]"
                      : "font-medium text-base-content/90",
                  ]}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        </aside>
      )
    }
  </div>
</PostLayout>

