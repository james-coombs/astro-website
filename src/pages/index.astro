---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import formatBlogLink from "../lib/formatBlogLink";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const last_posts = posts.slice(0, 3);

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "James Coombs",
  jobTitle: "Product Engineer",
  description:
    "I use rigorous data, modern architecture, and smart automation to close the gap between what users need and what engineering ships.",
  knowsAbout: [
    "AI Governance",
    "Design Engineering",
    "Performance Engineering",
    "Developer Experience",
    "TypeScript",
    "React",
    "Next.js",
  ],
};
---

<BaseLayout sideBarActiveItemID="home">
  <!-- JSON-LD Structured Data for Search Engine & AI Agent Discovery -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
  />

  <div class="mt-5">
    <div class="text-xl py-1">Hello!</div>
    <h1 class="text-5xl font-bold">James Coombs — Product Engineer</h1>
    <h2 class="text-2xl py-3 font-bold text-primary">
      I use rigorous data, modern architecture, and smart automation to close
      the gap between what users need and what engineering ships.
    </h2>

    <div class="py-2">
      <p class="text-lg">
        Most platform engineering stops at the component library or the
        deployment pipeline. I focus on the whole loop: finding the user
        friction, defining the business metric, building the architectural fix,
        and proving it moved.
      </p>
    </div>

    <div class="py-2">
      <p class="text-lg">
        I build the infrastructure, developer tooling, and UI abstractions that
        allow teams to ship high-performance web experiences at scale.
      </p>
    </div>
  </div>

  <hr class="my-5" />

  <div>
    <h2 class="text-3xl w-full font-bold mb-5">Latest from blog</h2>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={formatBlogLink(post.data.slug, post.id)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>

<script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": "James Coombs",
      "jobTitle": "Product Engineer",
      "url": "https://james-coombs.com",
      "sameAs": [
        "https://github.com/james-coombs",
        "https://www.linkedin.com/in/james-coombs"
      ],
      "knowsAbout": [
        "AI Governance",
        "Design Systems",
        "Web Performance Engineering",
        "Astro Framework",
        "TypeScript"
      ]
    }
  }
</script>
