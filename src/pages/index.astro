---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const last_posts = posts.slice(0, 3);

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "James Coombs",
  jobTitle: "Senior Design Engineer",
  description:
    "Building the systems and architecture that govern how humans and AI write code.",
  knowsAbout: [
    "AI Governance",
    "Design Engineering",
    "Performance Engineering",
    "Developer Experience",
    "TypeScript",
    "React",
    "Next.js",
  ],
};
---

<BaseLayout sideBarActiveItemID="home">
  <!-- JSON-LD Structured Data for Search Engine & AI Agent Discovery -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schemaData)}
  />

  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hello!</div>
    <h1 class="text-5xl font-bold">I'm James Coombs</h1>
    <h2 class="text-3xl py-3 font-bold text-primary">
      Senior Design Engineer | Founding the AI-Augmented Developer Experience
    </h2>

    <div class="py-2">
      <p class="text-lg">
        I build the systems and architecture that govern how humans and AI write
        code. Most Design Engineering stops at components. I focus on <strong
          >Governance at Scale</strong
        >: building the infrastructure and codified rules that let AI agents
        ship production code safely.
      </p>
    </div>

    <div class="py-2">
      <p class="text-lg">
        My background in Psychology is my edge in Developer Experience;
        architecting the mental models and "escape hatches" that allow
        engineering orgs to move fast without breaking.
      </p>
    </div>
  </div>

  <div>
    <h2 class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</h2>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.slug, post.id)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>

<script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": "James Coombs",
      "jobTitle": "Senior Design Engineer",
      "url": "https://james-coombs.com",
      "sameAs": [
        "https://github.com/james-coombs",
        "https://linkedin.com/in/jamescoombs"
      ],
      "knowsAbout": [
        "AI Governance",
        "Design Systems",
        "Web Performance Engineering",
        "Astro Framework",
        "TypeScript"
      ]
    }
  }
</script>
